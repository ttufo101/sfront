# 后端网关基址（可配置）。开发环境由 Vite dev proxy 转发到该地址以规避 CORS；
# 生产构建时前端会直接用该绝对地址调用（留空则同源，由网关反代 /startlandapi）。
# 例：VITE_API_BASE=http://47.120.10.73:12001
VITE_API_BASE=

# 文件服务基址（APK/日志上传与下载，独立 REST 服务），例：http://106.52.77.108:80
# 开发环境由 Vite dev proxy 把 /api/v1 反代到该地址；生产构建前端直连（需后端开放 CORS）。
VITE_FILE_API_BASE=

# 应用版本号，写入 xrpc 信封 com.app_ver
VITE_APP_VERSION=v0.1.0

# 设备类型（管理后台固定 pc）
VITE_DEV_TYPE=pc
